# Cloudflare Workers Static Assets serves every file with
# `Cache-Control: public, max-age=0, must-revalidate` by default — even
# content-hashed, genuinely immutable build output — so this file (same
# mechanism as Cloudflare Pages `_headers`) opts specific static asset
# paths into real browser caching. HTML documents, page routes, and the
# `/api/*` Worker routes are intentionally left out so they keep the
# default no-cache behaviour.

# Next.js/Turbopack build output — filenames are content-hashed, so a
# changed file always gets a new URL. Safe to cache for a year and mark
# immutable.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Site media and brand assets — filenames are NOT content-hashed, so a
# file replaced under the same name must still be picked up in a
# reasonable time. Long cache, but not immutable.
/media/*
  Cache-Control: public, max-age=2592000

/brand/*
  Cache-Control: public, max-age=2592000

# Favicon/icon assets — stable filenames but not content-hashed, so an
# appropriate (not extreme) cache lifetime.
/favicon.ico
  Cache-Control: public, max-age=86400

/icon.png
  Cache-Control: public, max-age=86400

/apple-icon.png
  Cache-Control: public, max-age=86400
