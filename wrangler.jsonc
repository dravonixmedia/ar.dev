{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar-dev",
  "compatibility_date": "2026-08-08",
  "main": "worker/index.ts",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/zoho-oauth-callback"]
  }
}
